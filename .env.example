# Documentation only: export these variables in your shell or hosting service.
PGDATABASE=basketball
PGUSER=basketball_app
PGPASSWORD=replace-with-your-local-password
PGHOST=127.0.0.1
PGPORT=5432
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-private-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:4200
# Hosted databases can use DATABASE_URL instead of the PG connection variables.
